# Copy to .env and adjust. Loaded automatically at startup (Node built-in).
# All values are optional; unset means "use the default".

# HTTP server
PORT=3000
LOG_LEVEL=info

# Bind address. Leave unset: the server then listens on 127.0.0.1 while the
# default password is in use, and on all interfaces (0.0.0.0) once you set a
# strong AUTH_PASSWORD below. An explicit non-loopback HOST (e.g. 0.0.0.0) with
# the default password — or with no authentication — makes the server REFUSE to
# start, so change the password first.
# HOST=0.0.0.0

# Login (username/password). Login is enabled BY DEFAULT with admin/admin so a
# freshly unpacked instance isn't open to anyone who reaches its port. The
# password "admin" (any case) is treated as the default whether or not it is
# written here, so the server stays loopback-only until you change it. The server
# only rejects the default — it cannot judge strength, so pick a strong one.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Optional static bearer token (alternative/legacy auth, accepted alongside login).
# AUTH_TOKEN=

# CORS origin for the API (default "*").
# CORS_ORIGIN=https://squash.example.com

# Override the served frontend directory (auto-derived next to the app otherwise).
# SQUASH_STATIC_DIR=/app/frontend/dist
