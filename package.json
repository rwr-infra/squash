{
  "name": "squash-rwr-terminal-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix frontend ci && npm --prefix frontend run build",
    "package": "npm run build && node scripts/package.mjs",
    "smoke:release": "vitest run --config test/e2e/e2e.config.ts --project release",
    "smoke:restart-policy": "vitest run --config test/e2e/e2e.config.ts --project restart-policy",
    "smoke:instance-form": "node scripts/smoke-instance-form.mjs",
    "smoke:server-log-ui": "node scripts/smoke-server-log-ui.mjs",
    "smoke:pty-exit-window": "node scripts/diagnostics/smoke-pty-exit-window.mjs",
    "smoke:pty-lifecycle": "node scripts/diagnostics/smoke-pty-lifecycle.mjs",
    "smoke:pty-cleanup": "node scripts/diagnostics/smoke-pty-cleanup.mjs",
    "smoke:pty-handles": "node scripts/diagnostics/smoke-pty-handles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.8.4",
    "node-pty": "1.2.0-beta.12",
    "pino": "10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "5.0.3",
    "pino-pretty": "^13.1.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "5.0.3"
  }
}
